# ============================================================
# Aether — environment configuration
# Copy to .env and fill in the secrets (change_me values).
# Everything the stack needs is configurable from here.
# ============================================================

# ---- ClickHouse ----
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change_me
CLICKHOUSE_PORT_HTTP=8123
CLICKHOUSE_PORT_NATIVE=9000
CLICKHOUSE_URL=http://clickhouse:8123

# ---- MinIO / S3 ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
MINIO_PORT_API=9000
MINIO_PORT_CONSOLE=9001
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me
S3_BUCKET=aether

# ---- Backend ----
BACKEND_PORT=8080
RUST_LOG=info
TZ=Europe/Moscow
SERVER_PATH=0.0.0.0:8080

# ---- Auth / shared secret ----
# API_KEY is shared between backend and agents. AUTH_CODE gates the web UI.
API_KEY=change_me
AUTH_CODE=change_me

# ============================================================
# Agent configuration
# ============================================================
# Where agents reach the backend. In-compose agents use the service DNS
# name (http://backend:8080). Remote agents on another server must set this
# to the backend's PUBLIC url, e.g. https://recon.example.com
EXTERNAL_SERVER_PATH=http://backend:8080

AGENT_PORT=8020
SCANS_OUTPUT_PATH=scans_output

# Concurrency: how many targets one agent runs at once, and how many tasks
# it leases from the backend queue. Raise on beefy agent hosts.
MAX_CONCURRENT_SCANS=3
MAX_CONCURRENT_TASKS=10
SCAN_COOLDOWN=60
HXN_DELAY=5

# httpx batch HTTP probe + screenshots. Higher threads/rate-limit = more
# throughput per agent (saturate the network link with few agents).
HTTPX_THREADS=50
HTTPX_RATE_LIMIT=150
HTTPX_TIMEOUT=10
HTTPX_SCREENSHOTS=true
# Web ports always probed by httpx per host (belt-and-suspenders over nmap)
HTTPX_WEB_PORTS=80,443,8080,8443,8000,8888

# nuclei "hunt" layer — runs over live URLs httpx confirms. Severity filter
# keeps noise down; add NUCLEI_TAGS to focus (e.g. exposure,misconfig,cve).
NUCLEI_ENABLED=true
NUCLEI_SEVERITY=critical,high,medium
NUCLEI_TAGS=
NUCLEI_RATE_LIMIT=150
NUCLEI_CONCURRENCY=25
NUCLEI_TIMEOUT=10

# tlsx (batch TLS grab + SAN/JARM pivot) and dnsx (batch resolver)
TLSX_CONCURRENCY=50
TLSX_TIMEOUT=5
DNSX_THREADS=100
GEO_ENABLED=true

# Comma-separated proxy pool (optional), e.g. socks5://user:pass@host:1080
PROXIES=

# ---- Shodan ----
# API key for the Shodan import tab. Stays server-side (backend only) — the
# frontend never sees it, all Shodan calls are proxied through the backend.
# Leave empty to disable the Shodan tab's live calls.
SHODAN_API_KEY=
