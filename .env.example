# PostgreSQL
POSTGRES_DB=aether
POSTGRES_USER=aether
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=aether
CLICKHOUSE_PORT_HTTP=8123
CLICKHOUSE_PORT_NATIVE=9000

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
MINIO_PORT_API=9000
MINIO_PORT_CONSOLE=9001

# Backend
BACKEND_PORT=8080
RUST_LOG=info
TZ=Europe/Moscow
SERVER_PATH=0.0.0.0:8080
DB_LOCATION=postgres://aether:change_me@postgres:5432/aether
CLICKHOUSE_URL=http://clickhouse:8123
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me
S3_BUCKET=aether

# API Key (shared between agent and backend)
API_KEY=change_me
