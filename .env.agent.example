# ============================================================
# Aether — remote agent host configuration (compose.agent.yml)
# Copy to .env on the agent server and fill in the two required values.
# ============================================================

# REQUIRED: public address of the central Aether backend.
EXTERNAL_SERVER_PATH=https://recon.example.com
# REQUIRED: the same API_KEY configured on the backend.
API_KEY=change_me
# RECOMMENDED enrollment flow: получи одноразовый токен на backend
#   curl -XPOST http://BACKEND/api/enroll-tokens -H "X-API-KEY: <admin>" \
#        -d '{"label":"vps-1","max_uses":1,"expires_in_hours":24}'
# и подставь сюда. Если задан — агент регистрируется по нему (API_KEY не нужен
# для регистрации). Стабильная идентичность хранится в AGENT_CREDENTIALS_PATH.
ENROLL_TOKEN=
# Человекочитаемое имя агента в панели (по умолчанию — hostname).
AGENT_NAME=

# ---- Optional agent tuning ----
RUST_LOG=info
TZ=Europe/Moscow
AGENT_PORT=8020
SCANS_OUTPUT_PATH=scans_output
MAX_CONCURRENT_SCANS=3
MAX_CONCURRENT_TASKS=10
# masscan line-rate discovery phase (Фаза 0). OFF by default — включай ТОЛЬКО
# на VPS-агентах, НЕ на домашней линии (line-rate SYN переполнит conntrack
# домашнего роутера). Требует cap_add NET_RAW/NET_ADMIN (уже в compose.agent.yml).
MASSCAN_ENABLED=false
# Пакетов/сек. Дома (если очень нужно) ≤100; на VPS можно 10000+.
MASSCAN_MAX_RATE=1000
MASSCAN_PORTS=80,443,8080,8443,22,21,25,3389,3306,5432,6379,9200,27017
MASSCAN_EXTRA_ARGS=
SCAN_COOLDOWN=60
HXN_DELAY=5

# httpx batch HTTP probe + screenshots
HTTPX_THREADS=50
HTTPX_RATE_LIMIT=150
HTTPX_TIMEOUT=10
HTTPX_SCREENSHOTS=true

# nuclei hunt layer
NUCLEI_ENABLED=true
NUCLEI_SEVERITY=critical,high,medium
NUCLEI_TAGS=
NUCLEI_RATE_LIMIT=150
NUCLEI_CONCURRENCY=25
NUCLEI_TIMEOUT=10

# tlsx + dnsx
TLSX_CONCURRENCY=50
TLSX_TIMEOUT=5
DNSX_THREADS=100

# Comma-separated proxy pool (optional)
PROXIES=
